## ================================================
## Local bin
## ================================================

SH_USER_BIN_CUSTOM="${HOME}/.local/sh/bin"
SH_USER_LIB_CUSTOM="${HOME}/.local/sh/lib"
LOCAL_BIN="${HOME}/.local/bin"
export PATH=$PATH:$SH_USER_BIN_CUSTOM:$SH_USER_LIB_CUSTOM:$LOCAL_BIN

