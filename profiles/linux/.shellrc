## ================================================
## Applications NodeJS in $HOME (node_modules)
## ================================================

if [[ -d "$HOME/node_modules/.bin" ]]; then
   YARN_BIN_USER="$HOME/node_modules/.bin"
   export PATH="$PATH:$YARN_BIN_USER"
fi
